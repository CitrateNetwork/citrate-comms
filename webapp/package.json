{
  "name": "citrate-comms-web",
  "version": "0.1.0",
  "private": true,
  "description": "Trusted-tier web client for citrate-comms — agentic team workspace (Comms + CRM + PM). Authenticates via the citrate-identity OIDC spine; shares one workspace with the native app via the comms-web-gateway bridge.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@ai-sdk/react": "^3.0.195",
    "@neondatabase/serverless": "^1.1.0",
    "@noble/hashes": "^1.6.1",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "@vercel/blob": "^2.4.1",
    "ai": "^6.0.193",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "next": "16.2.6",
    "nodemailer": "^9.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "fast-check": "^3.23.1",
    "globals": "^17.7.0",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@10.0.0"
}
