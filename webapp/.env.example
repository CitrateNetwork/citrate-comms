# ───────────────────────────────────────────────────────────────────────────
# citrate-comms web app — environment template. Copy to .env.local for dev.
# NEVER commit real secrets. CI runs gitleaks over this repo.
# ───────────────────────────────────────────────────────────────────────────

# --- Auth seam (citrate-identity OIDC spine) -------------------------------
# Client-safe (NEXT_PUBLIC_*) values for the browser half of the auth seam.
NEXT_PUBLIC_AUTH_MODE=oidc                               # oidc | mock (mock = dev only)
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:3000            # auth.citrate.ai in prod
NEXT_PUBLIC_OIDC_CLIENT_ID=citrate-comms-web
NEXT_PUBLIC_OIDC_SCOPE=openid profile wallet kyc offline_access

# Server-side OIDC verification (MUST both be set in oidc mode or every token is
# rejected — fail closed, FUA-EXPLORER-01). AUDIENCE must equal the client_id.
OIDC_ISSUER=http://localhost:3000
OIDC_AUDIENCE=citrate-comms-web
OIDC_JWKS_URL=http://localhost:3000/jwks
# ALLOW_MOCK_AUTH=1                                       # only for a non-public staging deploy

# --- Database (Neon) --------------------------------------------------------
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- At-rest field encryption (per-workspace AES-256-GCM) -------------------
# 32-byte base64 master key. Fail-closed if unset. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COMMS_ENC_KEY=

# --- Rate limiting (Upstash / Vercel KV) — fail-closed ----------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email invites (onboarding) --------------------------------------------
# Two transports; the first configured wins. Set RESEND_API_KEY (preferred).
#
# PREFERRED — Resend (HTTPS API, no SMTP AUTH to keep alive):
RESEND_API_KEY=                                          # re_… from resend.com  ← set this
EMAIL_FROM="Citrate Comms <no-reply@citrate.ai>"         # domain must be VERIFIED in Resend (SPF/DKIM/DMARC)
APP_ORIGIN=http://localhost:3004                         # absolute base for /join + /unsubscribe links
# For a first smoke test before the domain is verified, Resend allows sending only to
# your own account email from onboarding@resend.dev (leave EMAIL_FROM unset to use it).
#
# LEGACY FALLBACK — SMTP (only used when RESEND_API_KEY is unset). Note: Microsoft 365
# is retiring Basic Auth for SMTP client submission, so this path is fragile.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587                                          # 587 STARTTLS (default) | 465 implicit TLS
# SMTP_SECURE=false                                      # true only for port 465
# SMTP_USER=larry@citrate.ai                             # authenticating mailbox
# SMTP_PASS=                                             # app password if MFA

# --- Sync bridge (comms-web-gateway control API) — fast-follow --------------
# COMMS_GATEWAY_URL=http://127.0.0.1:8790
# COMMS_GATEWAY_BEARER=

# --- Pre-bounty hardening knobs (PBA-R2) ------------------------------------------
# Vercel Blob: attachments live in a PRIVATE store (BLOB_READ_WRITE_TOKEN; host derived as
# <storeid>.private.blob.vercel-storage.com). Override only if the private host differs:
# BLOB_STORE_HOST=<storeid>.private.blob.vercel-storage.com
# The old PUBLIC store, recognized only until scripts/harden-attachment-store.mjs has
# migrated it (then unset both and delete that store):
# BLOB_LEGACY_READ_WRITE_TOKEN=vercel_blob_rw_<oldStoreId>_…
# BLOB_LEGACY_PUBLIC_HOST=<oldstoreid>.public.blob.vercel-storage.com
# Signed-read lifetime for attachment downloads, seconds (clamped 30..600, default 120):
# BLOB_SIGNED_URL_TTL_SECONDS=120
# web.fetch escalates thin pages to the runner's Playwright fetcher ONLY when the runner
# enforces the private-address guard on every request it makes (PBA-L3c-010).
# COMMS_RUNNER_FETCH_GUARDED=1
# Logout revokes the refresh token (RFC 7009); defaults to $OIDC_ISSUER/token/revocation.
# OIDC_REVOCATION_URL=
