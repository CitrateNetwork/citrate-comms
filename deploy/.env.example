# citrate-comms relay environment — copy to /opt/citrate-comms/.env and fill in.
# Loaded by the systemd unit (EnvironmentFile). Keep this file 0600, owned by `comms`.

# Logical relay domain bound into the SIWE handshake. MUST equal the public hostname
# clients use AND each client's CITRATE_COMMS_DOMAIN. (The relay rejects a login whose
# SIWE domain doesn't match this.)
CITRATE_COMMS_DOMAIN=comms.example.com

# Listen address — loopback only; Caddy fronts it with TLS. Do NOT bind 0.0.0.0 here.
CITRATE_COMMS_BIND=127.0.0.1:8787

# Bearer-gated admin surface — loopback only, never proxied.
CITRATE_COMMS_ADMIN_BIND=127.0.0.1:8788

# RocksDB store path (ciphertext + routing metadata, AES-256-GCM at rest).
CITRATE_COMMS_DATA=/opt/citrate-comms/data

# Workspace owner wallet (the RBAC trust anchor) — the 0x address of the teammate who
# owns this workspace (e.g. you). REQUIRED. This is the address whose client should run
# in "create channel" mode (CITRATE_COMMS_PEER set).
CITRATE_COMMS_OWNER=0x0000000000000000000000000000000000000000

# At-rest master key, 64 hex (32 bytes). On a headless server the OS keyring (secret-
# service) is usually unavailable, so provide the key via a FILE whose PATH is named
# here — the key itself must NOT live inline in this env file, or it leaks via
# /proc/<pid>/environ and to every child process (CM2-B-A010). Generate once (0600) and
# keep it secret + backed up (losing it makes the at-rest store unreadable):
#     ( umask 077; openssl rand -hex 32 > /opt/citrate-comms/master.key )
CITRATE_COMMS_MASTER_KEY_FILE=/opt/citrate-comms/master.key
# Inline env key is accepted only with CITRATE_COMMS_ALLOW_ENV_KEY=1 (dev/test only):
# CITRATE_COMMS_MASTER_KEY=replace_me_with_64_hex_chars
