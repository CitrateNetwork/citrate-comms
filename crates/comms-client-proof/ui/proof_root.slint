// citrate-comms visual proof root (PoC) — a Window wrapper that renders real client
// UI (the brand theme + primitives) so the software renderer can snapshot it. Full
// per-screen proof roots (CommsScreen, CrmScreen, …) follow the same pattern (COMMS-S5).

import { Theme } from "../../comms-client/ui/theme.slint";
import { Card, Btn, Eyebrow, Avatar, Chip } from "../../comms-client/ui/primitives.slint";
import { CommsScreen } from "../../comms-client/ui/screen_comms.slint";
import { CrmScreen } from "../../comms-client/ui/screen_crm.slint";
import { SettingsScreen } from "../../comms-client/ui/screen_settings.slint";
import { ProjectsScreen } from "../../comms-client/ui/screen_projects.slint";
import { MembersScreen } from "../../comms-client/ui/screen_members.slint";
import { AgentsScreen } from "../../comms-client/ui/screen_agents.slint";
import { AuditScreen } from "../../comms-client/ui/screen_audit.slint";
import { SecurityScreen } from "../../comms-client/ui/screen_security.slint";
import { ForumScreen } from "../../comms-client/ui/screen_forum.slint";
// The full shell (title bar + rail + routed screen) — to prove the header-relative layout
// (the "content crashes past the header" report). Rendered with force-shell + a route.
import { AppWindow } from "../../comms-client/ui/app.slint";
export { AppWindow }

// Per-screen proof windows: render the REAL screen (with its design-time fixture data)
// at a given size, exactly as the content router mounts it. Goldens reveal the
// screen-internal layout (overlap, alignment, scroll-reach) at the SIZES matrix.
export component CommsProofWindow inherits Window {
    in property <length> proof-width: 1440px;
    in property <length> proof-height: 900px;
    width: root.proof-width;
    height: root.proof-height;
    CommsScreen { width: parent.width; height: parent.height; }
}

export component CrmProofWindow inherits Window {
    in property <length> proof-width: 1440px;
    in property <length> proof-height: 900px;
    width: root.proof-width;
    height: root.proof-height;
    CrmScreen { width: parent.width; height: parent.height; }
}

