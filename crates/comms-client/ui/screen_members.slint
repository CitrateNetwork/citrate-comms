// Members — the member directory. Everyone in the workspace, people and agents.
// Roles are signed grants; offboarding is forward-only and honest. Screen 04.
import { Theme, MemberRow } from "theme.slint";
import { Avatar, RoleGlyph, SurfBadge, Chip, Btn, Hairline, ScreenHead } from "primitives.slint";

// role filter chip — selectable
component FilterChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked;
    height: 28px;
    border-radius: 999px;
    border-width: 1px;
    border-color: root.selected ? Theme.citrate-green-deep : Theme.border-1;
    background: root.selected ? Theme.citrate-green-tint
        : (touch.has-hover ? Theme.paper-2 : Theme.paper-pure);
    animate background { duration: 140ms; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            color: root.selected ? Theme.citrate-green-dark : Theme.fg-2;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// one mono table-header label
component ColLabel inherits Text {
    color: Theme.fg-3;
    font-family: Theme.font-mono;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.2px;
    vertical-alignment: center;
}

export component MembersScreen inherits Rectangle {
    background: Theme.paper;
    callback invite();
    callback offboard();

    property <string> filter: "All";
    property <[string]> roles: ["All", "Owner", "Admin", "Member", "Partner", "Guest", "Agent"];

    // every member from data.jsx MEMBERS (people + agents)
    property <[MemberRow]> members: [
        { name: "Saul Loveman", initials: "SL", tint: #2f4502, role: "Owner", addr: "0x1f2e9c4a7b3d8e10aa9f", status: "active", external: false, devices: 3 },
        { name: "Priya Anand", initials: "PA", tint: #1b4965, role: "Admin", addr: "0x7a4b1d9e2c6f0837bb12", status: "active", external: false, devices: 2 },
        { name: "Mateo Ferraro", initials: "MF", tint: #6e5100, role: "Member", addr: "0x3c8f6e1a0d5b9274cc34", status: "active", external: false, devices: 1 },
        { name: "Hana Kobayashi", initials: "HK", tint: #5a8205, role: "Member", addr: "0x9d2a4f7c1e8b6053dd56", status: "active", external: false, devices: 2 },
        { name: "Ivo Petrov", initials: "IP", tint: #a72414, role: "Member", addr: "0x5e0b8d3a9f2c7164ee78", status: "invited", external: false, devices: 1 },
        { name: "Lena Brandt", initials: "LB", tint: #b07b00, role: "Partner", addr: "0x2b6c4e8a1d7f9305ff90", status: "active", external: true, devices: 1 },
        { name: "Q. Reviewer", initials: "QR", tint: #84867f, role: "Guest", addr: "0x8f1a3d6b2e9c0457a1b2", status: "active", external: false, devices: 1 },
        { name: "@crm-agent", initials: "CA", tint: #0e0f0c, role: "Agent", addr: "0xae71c0d4f93b2e6018c4", status: "active", external: false, devices: 1 },
        { name: "@notetaker", initials: "NT", tint: #0e0f0c, role: "Agent", addr: "0xbf82d1e5a04c3f7129d5", status: "active", external: false, devices: 1 },
    ];

    VerticalLayout {
        ScreenHead {
            title: "Members";
            subtitle: "Everyone in the workspace — people and agents. Roles are signed grants; offboarding is forward-only and honest.";
        }

        // toolbar: role filter chips + Invite
        Rectangle {
            height: 56px;
            background: Theme.paper;
            border-width: 1px;
            border-color: Theme.border-1;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 8px;
                alignment: start;
                for r[i] in root.roles: FilterChip {
                    text: r;
                    selected: root.filter == r;
                    clicked => { root.filter = r; }
                }
                Rectangle { horizontal-stretch: 1; }
                Btn {
                    text: "+ Invite";
                    primary: true;
                    h: 36px;
                    clicked => { root.invite(); }
                }
            }
        }

        // table
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            background: Theme.paper;
            VerticalLayout {
                padding: 24px;
                Rectangle {
                    background: Theme.paper-pure;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border-1;
                    VerticalLayout {
                        // header row
                        Rectangle {
                            height: 40px;
                            background: Theme.paper-2;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 16px;
                                alignment: start;
                                ColLabel { text: "MEMBER"; horizontal-stretch: 1; }
                                Rectangle { width: 240px; ColLabel { text: "ADDRESS"; } }
                                Rectangle { width: 120px; ColLabel { text: "ROLE"; } }
                                Rectangle { width: 110px; ColLabel { text: "STATUS"; } }
                                Rectangle { width: 70px; ColLabel { text: "DEVICES"; } }
                                Rectangle { width: 90px; }
                            }
                        }
                        Hairline { background: Theme.border-2; }

                        // member rows
                        for m[i] in root.members: VerticalLayout {
                            Rectangle {
                                height: 56px;
                                background: rowtouch.has-hover ? Theme.paper-2 : transparent;
                                rowtouch := TouchArea { mouse-cursor: pointer; }
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 16px;
                                    alignment: start;
                                    // member: avatar + name + AGENT/external
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        horizontal-stretch: 1;
                                        VerticalLayout {
                                            alignment: center;
                                            Avatar { initials: m.initials; tint: m.tint; agent: m.role == "Agent"; sz: 28px; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;
                                                Text {
                                                    text: m.name;
                                                    color: Theme.ink;
                                                    font-family: m.role == "Agent" ? Theme.font-mono : Theme.font-sans;
                                                    font-size: m.role == "Agent" ? 13px : 14px;
                                                    font-weight: 500;
                                                    vertical-alignment: center;
                                                }
                                                if m.role == "Agent": SurfBadge { text: "AGENT"; kind: "agent"; }
                                                if m.external: Chip { text: "External"; external: true; }
                                            }
                                        }
                                    }
                                    // address (mono)
                                    Rectangle {
                                        width: 240px;
                                        Text {
                                            text: m.addr;
                                            color: Theme.fg-2;
                                            font-family: Theme.font-mono;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    // role glyph + label
                                    Rectangle {
                                        width: 120px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            VerticalLayout {
                                                alignment: center;
                                                RoleGlyph { role: m.role; }
                                            }
                                            Text {
                                                text: m.role;
                                                color: Theme.fg-1;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    // status chip
                                    Rectangle {
                                        width: 110px;
                                        VerticalLayout {
                                            alignment: center;
                                            HorizontalLayout {
                                                alignment: start;
                                                Chip {
                                                    text: m.status == "invited" ? "Invited" : "Active";
                                                    accent: m.status != "invited";
                                                }
                                            }
                                        }
                                    }
                                    // device count (mono)
                                    Rectangle {
                                        width: 70px;
                                        Text {
                                            text: m.devices;
                                            color: Theme.fg-2;
                                            font-family: Theme.font-mono;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    // per-row offboard (not for Owner)
                                    Rectangle {
                                        width: 90px;
                                        VerticalLayout {
                                            alignment: center;
                                            if m.role != "Owner": Btn { text: "Offboard"; h: 28px; clicked => { root.offboard(); } }
                                        }
                                    }
                                }
                            }
                            if i < root.members.length - 1: Hairline { background: Theme.stone-150; }
                        }
                    }
                }
            }
        }
    }
}
