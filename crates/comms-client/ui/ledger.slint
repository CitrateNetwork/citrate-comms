// Ledger — the channel Ledger right-panel (the signature feature). Width 320px.
// Witnessed records: decisions & commitments lifted out of the conversation into a
// durable, auditable record.
import { Theme, LedgerEntry, Person } from "theme.slint";
import { Avatar, SurfBadge, Hairline, RoleGlyph, Chip, Btn } from "primitives.slint";

export component LedgerPanel inherits Rectangle {
    property <string> tab: "info"; // ledger | info
    in property <[Person]> members: [
        { name: "Saul Loveman", initials: "SL", tint: #2f4502, role: "Owner", addr: "0x1f2e9c4a…" },
        { name: "Priya Anand", initials: "PA", tint: #1b4965, role: "Admin", addr: "0x7a4b1d9e…" },
        { name: "Mateo Ferraro", initials: "MF", tint: #6e5100, role: "Member", addr: "0x3c8f6e1a…" },
        { name: "Lena Brandt", initials: "LB", tint: #b07b00, role: "Partner", addr: "0x2b6c4e8a…", external: true },
    ];
    callback add-agent();
    callback add-member();
    property <[LedgerEntry]> entries: [
        {
            kind: "commitment",
            text: "Brandt & Co. co-signs the deployment SOW this week — scoped to #deals.",
            by: "Lena Brandt",
            ts: "Jun 13",
            hash: "0x55f1…9d3b",
            owner: "Lena",
            due: "Jun 18",
            status: "open",
            has-commit: true,
        },
    ];

    // accent for the colored left rule per kind
    pure function rule-color(k: string) -> color {
        k == "commitment" ? Theme.yellow-deep
        : k == "resolved" ? Theme.info
        : Theme.citrate-green
    }
    pure function type-color(k: string) -> color {
        k == "commitment" ? Theme.yellow-dark
        : k == "resolved" ? Theme.info
        : Theme.citrate-green-deep
    }

    width: 320px;
    background: Theme.paper-2;
    border-width: 1px;
    border-color: Theme.border-1;

    VerticalLayout {
        // tab strip
        Rectangle {
            height: 44px;
            border-width: 1px;
            border-color: Theme.border-1;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px; spacing: 4px; alignment: start;

                // Info tab
                Rectangle {
                    horizontal-stretch: 0;
                    height: 44px;
                    accessible-role: button;
                    accessible-label: "ledger-tab:Info";
                    accessible-action-default => { root.tab = "info"; }
                    info-ta := TouchArea { mouse-cursor: pointer; clicked => { root.tab = "info"; } }
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 6px; alignment: center;
                        Text {
                            text: "Info";
                            color: root.tab == "info" ? Theme.ink : Theme.fg-3;
                            font-size: 14px; font-weight: 500; vertical-alignment: center;
                        }
                    }
                    if root.tab == "info": Rectangle { y: parent.height - 2px; height: 2px; background: Theme.citrate-green; }
                }

                // Ledger tab (with count)
                Rectangle {
                    horizontal-stretch: 0;
                    height: 44px;
                    accessible-role: button;
                    accessible-label: "ledger-tab:Ledger";
                    accessible-action-default => { root.tab = "ledger"; }
                    ledger-ta := TouchArea { mouse-cursor: pointer; clicked => { root.tab = "ledger"; } }
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 8px; alignment: center;
                        Text {
                            text: "Ledger";
                            color: root.tab == "ledger" ? Theme.ink : Theme.fg-3;
                            font-size: 14px; font-weight: 500; vertical-alignment: center;
                        }
                        Rectangle {
                            width: cnt.width + 12px; height: 16px; border-radius: 999px;
                            y: (parent.height - 16px) / 2;
                            background: root.tab == "ledger" ? Theme.citrate-green-tint : Theme.stone-150;
                            cnt := Text {
                                text: root.entries.length;
                                color: root.tab == "ledger" ? Theme.citrate-green-dark : Theme.fg-2;
                                font-family: Theme.font-mono; font-size: 10px;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                    if root.tab == "ledger": Rectangle { y: parent.height - 2px; height: 2px; background: Theme.citrate-green; }
                }
            }
        }

        // body
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            if root.tab == "ledger": VerticalLayout {
                accessible-role: text;
                accessible-label: "ledger-pane:ledger";
                padding: 16px;
                spacing: 12px;
                alignment: start;

                // intro line
                Text {
                    text: "Decisions & commitments, settled out of the conversation into a durable, auditable record.";
                    color: Theme.fg-3;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                for w[i] in root.entries: Rectangle {
                    background: Theme.paper-pure;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border-1;
                    height: entry.preferred-height;

                    // colored left rule
                    Rectangle {
                        x: 0; width: 3px;
                        y: 10px; height: parent.height - 20px;
                        border-radius: 999px;
                        background: root.rule-color(w.kind);
                    }

                    entry := VerticalLayout {
                        padding-top: 12px; padding-bottom: 12px;
                        padding-left: 20px; padding-right: 12px;
                        spacing: 6px;

                        // head: type label + hash
                        HorizontalLayout {
                            spacing: 6px; alignment: start;
                            Text {
                                text: w.kind == "commitment" ? "COMMITMENT" : w.kind == "resolved" ? "RESOLVED" : "DECISION";
                                color: root.type-color(w.kind);
                                font-family: Theme.font-mono; font-size: 9px; font-weight: 600;
                                letter-spacing: 0.9px; vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: w.hash;
                                color: Theme.fg-3;
                                font-family: Theme.font-mono; font-size: 10px;
                                vertical-alignment: center;
                            }
                        }

                        // record text
                        Text {
                            text: w.text;
                            color: Theme.ink;
                            font-size: 14px;
                            wrap: word-wrap;
                        }

                        // commitment row: done-check + owner + due
                        if w.has-commit: Rectangle {
                            height: commitrow.preferred-height + 16px;
                            // top hairline
                            Rectangle { y: 0; height: 1px; background: Theme.stone-100; }
                            commitrow := HorizontalLayout {
                                y: 8px;
                                spacing: 8px; alignment: start;
                                // done-check
                                Rectangle {
                                    width: 18px; height: 18px; border-radius: 5px;
                                    y: (parent.height - 18px) / 2;
                                    border-width: 1px;
                                    border-color: w.done ? Theme.citrate-green-deep : Theme.border-2;
                                    background: w.done ? Theme.citrate-green : transparent;
                                    if w.done: Text { text: "✓"; color: Theme.ink; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Avatar { initials: "LB"; tint: #b07b00; sz: 22px; }
                                Text { text: w.owner; color: Theme.fg-2; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                Text {
                                    text: "due " + w.due;
                                    color: Theme.fg-3;
                                    font-family: Theme.font-mono; font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // meta row (by · ts) — for non-commitment records
                        if !w.has-commit: HorizontalLayout {
                            spacing: 8px; alignment: start;
                            Avatar { initials: "LB"; tint: #b07b00; sz: 22px; }
                            Text { text: "Witnessed by " + w.by; color: Theme.fg-3; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: w.ts; color: Theme.fg-3; font-family: Theme.font-mono; font-size: 11px; vertical-alignment: center; }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }

            // Info tab — the channel roster (Encrypted · agents · members · add).
            if root.tab == "info": VerticalLayout {
                accessible-role: text;
                accessible-label: "ledger-pane:info";
                padding: 20px;
                spacing: 14px;
                alignment: start;
                HorizontalLayout {
                    spacing: 8px; alignment: start;
                    Text { text: "🔒"; font-size: 14px; vertical-alignment: center; }
                    Text { text: "Encrypted — 5 members"; color: Theme.ink; font-size: 15px; font-weight: 600; vertical-alignment: center; }
                }
                Text { text: "Pipeline, partners, and the deals desk."; color: Theme.fg-2; font-size: 13px; wrap: word-wrap; }
                Text { text: "AGENTS IN CHANNEL"; color: Theme.fg-3; font-family: Theme.font-mono; font-size: 11px; letter-spacing: 1.4px; }
                HorizontalLayout {
                    spacing: 10px; alignment: start;
                    Avatar { initials: "CA"; agent: true; sz: 32px; }
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "@crm-agent"; color: Theme.ink; font-family: Theme.font-mono; font-size: 13px; vertical-alignment: center; }
                            SurfBadge { text: "AGENT"; }
                        }
                        Text { text: "read + post · cannot change membership"; color: Theme.fg-3; font-size: 11px; }
                    }
                }
                Text { text: "MEMBERS · 4"; color: Theme.fg-3; font-family: Theme.font-mono; font-size: 11px; letter-spacing: 1.4px; }
                for p[i] in root.members: HorizontalLayout {
                    spacing: 12px; alignment: start;
                    Avatar { initials: p.initials; tint: p.tint; sz: 32px; }
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: p.name; color: Theme.ink; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                            RoleGlyph { role: p.role; }
                            if p.external: Chip { text: "ext"; external: true; }
                        }
                        Text { text: p.addr; color: Theme.fg-3; font-family: Theme.font-mono; font-size: 11px; }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                Btn { text: "Add member"; clicked => { root.add-member(); } }
                Btn { text: "Add an agent"; clicked => { root.add-agent(); } }
            }
        }
    }
}
