// Security — cryptographic posture surface. Screen 05.
// Shows the ACTUALLY-IMPLEMENTED classical MLS suite (X25519 / AES-128-GCM / Ed25519,
// RFC 9420) and forward secrecy. Post-quantum (X25519+ML-KEM-768 hybrid) is on the
// roadmap — NOT yet implemented — and is labelled as such, never as live (FWA-C11-02/06).
import { Theme, SuiteRow, HandshakeStep, Device } from "theme.slint";
import { Card, Eyebrow, SevDot, ScreenHead, SelText, CellText } from "primitives.slint";

// amber "ROADMAP" pill — for cipher-suite rows that are PLANNED, not yet implemented.
// (We must never present a not-yet-shipped algorithm as the live suite — FWA-C11-02/06.)
component RoadmapBadge inherits Rectangle {
    in property <string> text: "ROADMAP";
    height: 22px;
    border-radius: 999px;
    background: transparent;
    border-width: 1px;
    border-color: Theme.border-2;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: center;
        Text {
            text: "○";
            color: Theme.fg-3;
            font-family: Theme.font-mono; font-size: 11px; font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: Theme.fg-3;
            font-family: Theme.font-mono; font-size: 10px; font-weight: 600;
            letter-spacing: 0.6px; vertical-alignment: center;
        }
    }
}

// green "LIVE" badge for the active (implemented) suite rows.
component LiveBadge inherits Rectangle {
    height: 22px;
    border-radius: 999px;
    background: Theme.citrate-green-tint;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: center;
        Text {
            text: "✓";
            color: Theme.citrate-green-deep;
            font-family: Theme.font-mono; font-size: 11px; font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: "LIVE";
            color: Theme.citrate-green-dark;
            font-family: Theme.font-mono; font-size: 10px; font-weight: 600;
            letter-spacing: 0.6px; vertical-alignment: center;
        }
    }
}

component SuiteRowView inherits Rectangle {
    in property <SuiteRow> s;
    in property <string> note;
    in property <bool> last: false;
    height: 56px;
    if !root.last: Rectangle {
        y: parent.height - 1px; height: 1px; background: Theme.stone-100;
    }
    HorizontalLayout {
        spacing: 12px; alignment: start;
        CellText { width: 150px; text: root.s.role; color: Theme.fg-2; font-size: 13px; }
        VerticalLayout {
            alignment: center; spacing: 2px; horizontal-stretch: 1;
            SelText {
                text: root.s.algo;
                color: Theme.ink; font-family: Theme.font-mono; font-size: 14px; font-weight: 500;
            }
            SelText {
                text: root.note;
                color: Theme.fg-3; font-size: 12px;
            }
        }
        Rectangle {
            width: 110px;
            HorizontalLayout {
                alignment: end;
                // `s.pq` now flags a PLANNED (roadmap) row; live rows show LIVE.
                if root.s.pq: RoadmapBadge { }
                if !root.s.pq: LiveBadge { }
            }
        }
    }
}

component HandshakeStepView inherits Rectangle {
    in property <HandshakeStep> h;
    in property <bool> last: false;
    HorizontalLayout {
        spacing: 12px; alignment: start;
        // dot + connector rail
        Rectangle {
            width: 28px;
            VerticalLayout {
                alignment: start; spacing: 0;
                Rectangle {
                    height: 17px;
                    Rectangle {
                        width: 11px; height: 11px; border-radius: 5.5px;
                        x: (parent.width - 11px) / 2;
                        y: 4px;
                        background: root.h.done ? Theme.citrate-green : Theme.paper;
                        border-width: root.h.done ? 3px : 1.5px;
                        border-color: root.h.done ? Theme.citrate-green-tint : Theme.border-2;
                    }
                }
                if !root.last: Rectangle {
                    width: 2px; vertical-stretch: 1;
                    x: (parent.width - 2px) / 2;
                    background: Theme.citrate-green-tint;
                }
            }
        }
        VerticalLayout {
            padding-bottom: 18px; spacing: 2px; horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px; alignment: start;
                SelText {
                    text: root.h.name;
                    color: Theme.ink; font-size: 14px; font-weight: 600;
                }
                if root.h.done: Text {
                    text: "✓";
                    color: Theme.citrate-green-deep; font-family: Theme.font-mono;
                    font-size: 13px; font-weight: 600; vertical-alignment: center;
                }
                if !root.h.done: Text {
                    text: "ROADMAP";
                    color: Theme.fg-3; font-family: Theme.font-mono;
                    font-size: 10px; font-weight: 600; letter-spacing: 0.6px; vertical-alignment: center;
                }
            }
            SelText {
                text: root.h.desc;
                color: Theme.fg-2; font-size: 13px;
            }
        }
    }
}

export component SecurityScreen inherits Rectangle {
    background: Theme.paper;
    // pq: true == PLANNED (roadmap, not implemented); pq: false == LIVE today.
    property <[SuiteRow]> suite: [
        { role: "Key exchange (KEM)", algo: "X25519 (DHKEM)", pq: false },
        { role: "Signatures", algo: "Ed25519", pq: false },
        { role: "Group protocol", algo: "MLS / TreeKEM", pq: false },
        { role: "Transport AEAD", algo: "AES-128-GCM", pq: false },
        { role: "Hash / KDF", algo: "SHA-256 · HKDF", pq: false },
        { role: "At-rest AEAD", algo: "AES-256-GCM-SIV", pq: false },
        { role: "PQ key exchange", algo: "X25519 + ML-KEM-768", pq: true },
        { role: "PQ signatures", algo: "ML-DSA-65", pq: true },
    ];
    property <[string]> suite-notes: [
        "RFC 9420 · MLS_128_DHKEMX25519_AES128GCM_SHA256_Ed25519",
        "RFC 9420 · classical EdDSA leaf credentials",
        "RFC 9420 · forward-secret group ratchet (FS / PCS)",
        "Classical 128-bit AEAD (the live MLS ciphersuite)",
        "Classical digest in the live suite",
        "Nonce-misuse-resistant at-rest column-family encryption",
        "Roadmap — hybrid lattice KEM, pending a ratified MLS PQ ciphersuite",
        "Roadmap — module-lattice signatures (FIPS 204)",
    ];
    property <[HandshakeStep]> steps: [
        { name: "Client hello + X25519 key share", desc: "Device publishes a KeyPackage with an X25519 init key (classical DHKEM).", done: true },
        { name: "MLS welcome + epoch 0", desc: "New member is admitted; the TreeKEM tree seals a fresh group secret (forward secrecy).", done: true },
        { name: "Forward-secret session live", desc: "Every epoch rotates the group secret; a removed member cannot read future epochs.", done: true },
        { name: "Post-quantum hybrid (roadmap)", desc: "When a hybrid X25519+ML-KEM-768 MLS ciphersuite ratifies, groups migrate epoch-by-epoch via the reserved ciphersuite_id. Not yet enabled.", done: false },
    ];

    VerticalLayout {
        ScreenHead {
            title: "Security";
            subtitle: "Cryptographic posture — end-to-end encrypted, forward-secret by design.";
        }
        Rectangle {
            vertical-stretch: 1; clip: true; background: Theme.paper;
            VerticalLayout {
                padding: 24px; spacing: 16px;

                // ── hero ──
                Rectangle {
                    background: Theme.paper;
                    VerticalLayout {
                        spacing: 12px;
                        Eyebrow { text: "SECURITY · CRYPTOGRAPHIC POSTURE"; }
                        HorizontalLayout {
                            spacing: 16px; alignment: start;
                            Text {
                                text: "End-to-end encrypted. Forward-secret.";
                                color: Theme.ink; font-family: Theme.font-display;
                                font-weight: 500; font-size: 36px; vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            // live-encryption pill (honest: E2E + FS today; PQ is roadmap)
                            Rectangle {
                                height: 40px; border-radius: 999px; background: Theme.ink;
                                horizontal-stretch: 0;
                                y: (parent.height - 40px) / 2;
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 16px; spacing: 10px; alignment: center;
                                    SevDot { level: "pass"; }
                                    Text {
                                        text: "E2E encrypted";
                                        color: Theme.citrate-green; font-size: 14px; font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "· all channels";
                                        color: Theme.sealed-fg-2; font-family: Theme.font-mono;
                                        font-size: 11px; vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Rectangle {
                            max-width: 720px;
                            VerticalLayout {
                                alignment: start;
                                Text {
                                    text: "Every message is sealed end-to-end with the MLS protocol (RFC 9420) over X25519 and AES-GCM — the relay never sees plaintext or group secrets. Each epoch rotates the group key, so removing a member cuts off their access to future messages (forward secrecy / post-compromise security). Post-quantum hybrid key exchange (X25519 + ML-KEM-768) is on the roadmap, pending a ratified MLS PQ ciphersuite — it is not enabled today.";
                                    color: Theme.fg-2; font-size: 15px; wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // ── cipher suite + handshake (two columns) ──
                HorizontalLayout {
                    spacing: 16px; alignment: start;

                    // cipher suite card (wider)
                    Card {
                        horizontal-stretch: 13;
                        VerticalLayout {
                            padding: 20px; spacing: 0;
                            HorizontalLayout {
                                spacing: 8px; alignment: start;
                                Text { text: "🛡"; color: Theme.citrate-green-deep; font-size: 16px; vertical-alignment: center; }
                                Eyebrow { text: "ACTIVE CIPHER SUITE"; vertical-alignment: center; }
                            }
                            Rectangle { height: 12px; }
                            for s[i] in root.suite: SuiteRowView {
                                s: s;
                                note: root.suite-notes[i];
                                last: i == root.suite.length - 1;
                            }
                        }
                    }

                    // handshake walk card (narrower)
                    Card {
                        horizontal-stretch: 10;
                        VerticalLayout {
                            padding: 20px; spacing: 0;
                            HorizontalLayout {
                                spacing: 8px; alignment: start;
                                Text { text: "🔑"; color: Theme.citrate-green-deep; font-size: 16px; vertical-alignment: center; }
                                Eyebrow { text: "MLS HANDSHAKE"; vertical-alignment: center; }
                            }
                            Rectangle { height: 16px; }
                            for h[i] in root.steps: HandshakeStepView {
                                h: h;
                                last: i == root.steps.length - 1;
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}
