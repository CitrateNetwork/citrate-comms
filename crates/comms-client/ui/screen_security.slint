// Security — post-quantum cryptographic posture surface. Screen 05.
// Hero (quantum-resistant by design), active cipher suite, post-quantum handshake walk.
import { Theme, SuiteRow, HandshakeStep, Device } from "theme.slint";
import { Card, Eyebrow, SevDot, ScreenHead } from "primitives.slint";

// green "PQ" / "HYBRID PQ" pill
component PqBadge inherits Rectangle {
    in property <string> text: "PQ";
    height: 22px;
    border-radius: 999px;
    background: Theme.citrate-green-tint;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: center;
        Text {
            text: "✓";
            color: Theme.citrate-green-deep;
            font-family: Theme.font-mono; font-size: 11px; font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: Theme.citrate-green-dark;
            font-family: Theme.font-mono; font-size: 10px; font-weight: 600;
            letter-spacing: 0.6px; vertical-alignment: center;
        }
    }
}

// outline "PFS" badge for non-PQ rows
component PfsBadge inherits Rectangle {
    height: 18px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border-2;
    background: transparent;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 7px; padding-right: 7px;
        Text {
            text: "PFS";
            color: Theme.fg-3;
            font-family: Theme.font-mono; font-size: 10px; font-weight: 500;
            letter-spacing: 0.8px; vertical-alignment: center;
        }
    }
}

component SuiteRowView inherits Rectangle {
    in property <SuiteRow> s;
    in property <string> note;
    in property <bool> hybrid: false;
    in property <bool> last: false;
    height: 56px;
    if !root.last: Rectangle {
        y: parent.height - 1px; height: 1px; background: Theme.stone-100;
    }
    HorizontalLayout {
        spacing: 12px; alignment: start;
        Text {
            text: root.s.role;
            color: Theme.fg-2; font-size: 13px; vertical-alignment: center;
            width: 150px; overflow: elide;
        }
        VerticalLayout {
            alignment: center; spacing: 2px; horizontal-stretch: 1;
            Text {
                text: root.s.algo;
                color: Theme.ink; font-family: Theme.font-mono; font-size: 14px; font-weight: 500;
                overflow: elide;
            }
            Text {
                text: root.note;
                color: Theme.fg-3; font-size: 12px; overflow: elide;
            }
        }
        Rectangle {
            width: 96px;
            HorizontalLayout {
                alignment: end;
                if root.s.pq: PqBadge { text: root.hybrid ? "HYBRID PQ" : "PQ"; }
                if !root.s.pq: PfsBadge { }
            }
        }
    }
}

component HandshakeStepView inherits Rectangle {
    in property <HandshakeStep> h;
    in property <bool> last: false;
    HorizontalLayout {
        spacing: 12px; alignment: start;
        // dot + connector rail
        Rectangle {
            width: 28px;
            VerticalLayout {
                alignment: start; spacing: 0;
                Rectangle {
                    height: 17px;
                    Rectangle {
                        width: 11px; height: 11px; border-radius: 5.5px;
                        x: (parent.width - 11px) / 2;
                        y: 4px;
                        background: Theme.citrate-green;
                        border-width: 3px;
                        border-color: Theme.citrate-green-tint;
                    }
                }
                if !root.last: Rectangle {
                    width: 2px; vertical-stretch: 1;
                    x: (parent.width - 2px) / 2;
                    background: Theme.citrate-green-tint;
                }
            }
        }
        VerticalLayout {
            padding-bottom: 18px; spacing: 2px; horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px; alignment: start;
                Text {
                    text: root.h.name;
                    color: Theme.ink; font-size: 14px; font-weight: 600; vertical-alignment: center;
                }
                Text {
                    text: "✓";
                    color: Theme.citrate-green-deep; font-family: Theme.font-mono;
                    font-size: 13px; font-weight: 600; vertical-alignment: center;
                }
            }
            Text {
                text: root.h.desc;
                color: Theme.fg-2; font-size: 13px; wrap: word-wrap;
            }
        }
    }
}

export component SecurityScreen inherits Rectangle {
    background: Theme.paper;
    property <[SuiteRow]> suite: [
        { role: "Key exchange (KEM)", algo: "X25519 + ML-KEM-768", pq: true },
        { role: "Signatures", algo: "ML-DSA-65", pq: true },
        { role: "Group protocol", algo: "MLS / TreeKEM", pq: false },
        { role: "AEAD", algo: "AES-256-GCM", pq: true },
        { role: "Hash / KDF", algo: "SHA3-256 · HKDF", pq: true },
        { role: "Transport", algo: "TLS 1.3 (hybrid)", pq: true },
    ];
    property <[string]> suite-notes: [
        "Hybrid — classical + lattice KEM (FIPS 203)",
        "Module-lattice signatures (FIPS 204)",
        "RFC 9420 · forward-secret group ratchet",
        "256-bit — quantum-resistant at this size",
        "Grover-resistant digest",
        "Relay link also PQ-wrapped",
    ];
    property <[HandshakeStep]> steps: [
        { name: "Client hello + key shares", desc: "Device offers an X25519 share and an ML-KEM-768 encapsulation key in the same flight." },
        { name: "Hybrid key encapsulation", desc: "Shared secret derived from both the classical and the lattice exchange — broken only if both are broken." },
        { name: "MLS welcome + epoch 0", desc: "New member is admitted to the group; the TreeKEM tree seals a fresh group secret." },
        { name: "Post-quantum session live", desc: "All envelopes from here are sealed with keys no quantum adversary can recover." },
    ];

    VerticalLayout {
        ScreenHead {
            title: "Security";
            subtitle: "Cryptographic posture — quantum-resistant by design.";
        }
        Rectangle {
            vertical-stretch: 1; clip: true; background: Theme.paper;
            VerticalLayout {
                padding: 24px; spacing: 16px;

                // ── hero ──
                Rectangle {
                    background: Theme.paper;
                    VerticalLayout {
                        spacing: 12px;
                        Eyebrow { text: "SECURITY · CRYPTOGRAPHIC POSTURE"; }
                        HorizontalLayout {
                            spacing: 16px; alignment: start;
                            Text {
                                text: "Quantum-resistant by design.";
                                color: Theme.ink; font-family: Theme.font-display;
                                font-weight: 500; font-size: 36px; vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            // post-quantum secure pill
                            Rectangle {
                                height: 40px; border-radius: 999px; background: Theme.ink;
                                horizontal-stretch: 0;
                                y: (parent.height - 40px) / 2;
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 16px; spacing: 10px; alignment: center;
                                    SevDot { level: "pass"; }
                                    Text {
                                        text: "Post-quantum secure";
                                        color: Theme.citrate-green; font-size: 14px; font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "· all channels";
                                        color: Theme.sealed-fg-2; font-family: Theme.font-mono;
                                        font-size: 11px; vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Rectangle {
                            max-width: 720px;
                            VerticalLayout {
                                alignment: start;
                                Text {
                                    text: "Every message is sealed with a hybrid scheme — today's elliptic-curve cryptography and NIST's lattice standards together. An adversary would have to break both. This defends against harvest-now, decrypt-later: traffic captured today stays unreadable even when large quantum computers arrive.";
                                    color: Theme.fg-2; font-size: 15px; wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // ── cipher suite + handshake (two columns) ──
                HorizontalLayout {
                    spacing: 16px; alignment: start;

                    // cipher suite card (wider)
                    Card {
                        horizontal-stretch: 13;
                        VerticalLayout {
                            padding: 20px; spacing: 0;
                            HorizontalLayout {
                                spacing: 8px; alignment: start;
                                Text { text: "🛡"; color: Theme.citrate-green-deep; font-size: 16px; vertical-alignment: center; }
                                Eyebrow { text: "ACTIVE CIPHER SUITE"; vertical-alignment: center; }
                            }
                            Rectangle { height: 12px; }
                            for s[i] in root.suite: SuiteRowView {
                                s: s;
                                note: root.suite-notes[i];
                                hybrid: i == 0;
                                last: i == root.suite.length - 1;
                            }
                        }
                    }

                    // handshake walk card (narrower)
                    Card {
                        horizontal-stretch: 10;
                        VerticalLayout {
                            padding: 20px; spacing: 0;
                            HorizontalLayout {
                                spacing: 8px; alignment: start;
                                Text { text: "🔑"; color: Theme.citrate-green-deep; font-size: 16px; vertical-alignment: center; }
                                Eyebrow { text: "POST-QUANTUM HANDSHAKE"; vertical-alignment: center; }
                            }
                            Rectangle { height: 16px; }
                            for h[i] in root.steps: HandshakeStepView {
                                h: h;
                                last: i == root.steps.length - 1;
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}
