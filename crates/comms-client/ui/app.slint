// citrate-comms — native client (COMMS-S2). Shell + router; screens are per-file.
import { Theme, Chan, Msg, Person, Deal, Task, MemberRow, AuditRow } from "theme.slint";
import { Avatar } from "primitives.slint";
import { CommsScreen } from "screen_comms.slint";
import { CrmScreen } from "screen_crm.slint";
import { ProjectsScreen } from "screen_projects.slint";
import { AgentsScreen } from "screen_agents.slint";
import { MembersScreen } from "screen_members.slint";
import { AuditScreen } from "screen_audit.slint";
import { SecurityScreen } from "screen_security.slint";
import { SettingsScreen } from "screen_settings.slint";
import { AuthScreen } from "screen_auth.slint";
import { ForumScreen } from "screen_forum.slint";
import { AddAgentDialog, OffboardDialog, InviteDialog } from "overlays.slint";
import { CommandPalette, MeMenu } from "nav.slint";

component RailItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> sealed: false;     // Audit item uses the dark treatment
    callback clicked;
    // Accessibility + test addressing (the hit-target/interaction harness finds these).
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    height: 34px;
    border-radius: 6px;
    background: root.active ? (root.sealed ? Theme.deep-evergreen : Theme.citrate-green-tint)
        : (ta.has-hover ? (root.sealed ? Theme.deep-evergreen : Theme.stone-100) : transparent);
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; alignment: start;
        Text {
            text: root.label;
            color: root.active ? (root.sealed ? Theme.sealed-fg : Theme.citrate-green-dark)
                : (root.sealed ? Theme.sealed-fg-2 : Theme.fg-2);
            font-size: 14px; font-weight: root.active ? 600 : 400; vertical-alignment: center;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    title: "citrate-comms";
    default-font-family: Theme.font-sans;
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1100px;
    min-height: 720px;
    background: Theme.paper;

    in-out property <string> route: "comms";
    property <bool> signed-in: false;
    // test hook (visual proof harness): render the signed-in shell without the live relay.
    in property <bool> force-shell: false;
    property <bool> show-shell: root.signed-in || root.force-shell;
    in-out property <string> overlay: "";  // "" | addAgent | offboard | invite
    in-out property <bool> cmdk: false;
    in-out property <bool> me-open: false;

    // live data from the backend (src/backend.rs); main.rs sets these.
    in property <[Msg]> ws-messages;
    in property <[Person]> ws-members;
    in property <[Deal]> ws-deals;
    in property <[Task]> ws-tasks;
    in property <[MemberRow]> ws-member-rows;
    in property <[AuditRow]> ws-audit;
    // connection state for the header pill (main.rs sets these).
    in property <string> relay-status: "demo";
    in property <string> relay-endpoint: "in-process";
    in property <bool> relay-ok: true;
    callback send-message(string);
    // fired when the user signs in — main.rs kicks off the networked connect/login.
    callback connect();
    // fired from the Invite dialog with a 0x address — create a channel + invite them.
    callback create-channel(string);
    property <[Chan]> rail-channels: [
        { name: "deals", unread: 3, active: true },
        { name: "announcements", forum: true },
        { name: "eng" },
        { name: "design" },
        { name: "security", unread: 1 },
    ];

    if !root.show-shell: AuthScreen {
        signed-in => { root.signed-in = true; root.connect(); }
    }

    if root.show-shell: FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if ((event.modifiers.control || event.modifiers.meta) && event.text == "k") {
                root.cmdk = !root.cmdk;
                return EventResult.accept;
            }
            if (event.text == Key.Escape) {
                root.cmdk = false;
                root.me-open = false;
                root.overlay = "";
                return EventResult.accept;
            }
            return EventResult.reject;
        }
        VerticalLayout {
        spacing: 0;
        // ── title bar ──
        Rectangle {
            height: 44px; background: Theme.paper-2; border-width: 1px; border-color: Theme.border-1;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; spacing: 12px;
                HorizontalLayout {
                    spacing: 10px; alignment: start;
                    Rectangle {
                        width: 50px;
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            Rectangle { width: 12px; height: 12px; border-radius: 6px; background: #ec6a5e; y: (parent.height - 12px)/2; }
                            Rectangle { width: 12px; height: 12px; border-radius: 6px; background: #f4bf4f; y: (parent.height - 12px)/2; }
                            Rectangle { width: 12px; height: 12px; border-radius: 6px; background: #61c554; y: (parent.height - 12px)/2; }
                        }
                    }
                    Rectangle {
                        width: 22px; height: 22px; border-radius: 6px; background: Theme.ink; y: (parent.height - 22px) / 2;
                        Text { text: "◆"; color: Theme.citrate-green; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "Citrate HQ"; color: Theme.ink; font-family: Theme.font-display; font-weight: 500; font-size: 14px; vertical-alignment: center; }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    Rectangle {
                        width: 360px; height: 28px; border-radius: 999px;
                        x: (parent.width - 360px) / 2; y: (parent.height - 28px) / 2;
                        background: search-ta.has-hover ? Theme.stone-50 : Theme.paper-pure; border-width: 1px; border-color: Theme.border-1;
                        Text { text: "Search this device · go to anything                              ⌘K"; color: Theme.fg-3; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; }
                        search-ta := TouchArea { mouse-cursor: pointer; clicked => { root.cmdk = true; } }
                    }
                }
                HorizontalLayout {
                    spacing: 10px; alignment: end;
                    Rectangle {
                        height: 28px; border-radius: 999px; border-width: 1px; border-color: Theme.border-1; background: Theme.paper-pure; y: (parent.height - 28px) / 2;
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; spacing: 8px; alignment: center;
                            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.relay-ok ? Theme.citrate-green : #f4bf4f; y: (parent.height - 8px)/2; }
                            Text { text: root.relay-status; color: Theme.fg-2; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                            Text { text: "· " + root.relay-endpoint; color: Theme.fg-3; font-family: Theme.font-mono; font-size: 11px; vertical-alignment: center; }
                        }
                    }
                    Rectangle {
                        width: 26px; height: 26px; y: (parent.height - 26px) / 2;
                        Avatar { initials: "SL"; tint: #2f4502; sz: 26px; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.me-open = !root.me-open; } }
                    }
                }
            }
        }

        // ── body ──
        HorizontalLayout {
            spacing: 0;
            // left rail (240)
            Rectangle {
                width: 240px; background: Theme.paper-2; border-width: 1px; border-color: Theme.border-1;
                VerticalLayout {
                    padding: 12px; spacing: 2px;
                    Text { text: "SPACES"; color: Theme.fg-3; font-family: Theme.font-mono; font-size: 11px; letter-spacing: 1.4px; }
                    for c[i] in root.rail-channels: RailItem {
                        label: (c.forum ? "≡ " : "# ") + c.name;
                        active: (root.route == "comms" && c.active) || (root.route == "forum" && c.forum);
                        clicked => { root.route = c.forum ? "forum" : "comms"; }
                    }
                    Rectangle { height: 12px; }
                    RailItem { label: "CRM"; active: root.route == "crm"; clicked => { root.route = "crm"; } }
                    RailItem { label: "Projects"; active: root.route == "projects"; clicked => { root.route = "projects"; } }
                    RailItem { label: "Agents"; active: root.route == "agents"; clicked => { root.route = "agents"; } }
                    RailItem { label: "Members"; active: root.route == "members"; clicked => { root.route = "members"; } }
                    Rectangle { vertical-stretch: 1; }
                    RailItem { label: "Security"; active: root.route == "security"; clicked => { root.route = "security"; } }
                    RailItem { label: "Audit"; sealed: true; active: root.route == "audit"; clicked => { root.route = "audit"; } }
                    RailItem { label: "Settings"; active: root.route == "settings"; clicked => { root.route = "settings"; } }
                }
            }

            // content router — each screen fills the content area exactly (below the
            // title bar) and clips its own overflow, so nothing bleeds past the header.
            Rectangle {
                horizontal-stretch: 1; background: Theme.paper; clip: true;
                if root.route == "comms": CommsScreen {
                    width: 100%; height: 100%;
                    messages: root.ws-messages;
                    members: root.ws-members;
                    send(t) => { root.send-message(t); }
                    add-agent => { root.overlay = "addAgent"; }
                    add-member => { root.overlay = "invite"; }
                }
                if root.route == "forum": ForumScreen { width: 100%; height: 100%; }
                if root.route == "crm": CrmScreen { width: 100%; height: 100%; deals: root.ws-deals; }
                if root.route == "projects": ProjectsScreen { width: 100%; height: 100%; tasks: root.ws-tasks; }
                if root.route == "agents": AgentsScreen { width: 100%; height: 100%; }
                if root.route == "members": MembersScreen {
                    width: 100%; height: 100%;
                    members: root.ws-member-rows;
                    invite => { root.overlay = "invite"; }
                    offboard => { root.overlay = "offboard"; }
                }
                if root.route == "audit": AuditScreen { width: 100%; height: 100%; records: root.ws-audit; }
                if root.route == "security": SecurityScreen { width: 100%; height: 100%; }
                if root.route == "settings": SettingsScreen { width: 100%; height: 100%; }
            }
        }
        }
    }

    // ── overlays (full-window scrim dialogs) ──
    if root.show-shell && root.overlay == "addAgent": AddAgentDialog {
        width: 100%; height: 100%;
        close => { root.overlay = ""; }
    }
    if root.show-shell && root.overlay == "offboard": OffboardDialog {
        width: 100%; height: 100%;
        close => { root.overlay = ""; }
    }
    if root.show-shell && root.overlay == "invite": InviteDialog {
        width: 100%; height: 100%;
        invite-address(a) => { root.create-channel(a); }
        close => { root.overlay = ""; }
    }

    // ── command palette (⌘K / search) + me-menu ──
    if root.show-shell && root.cmdk: CommandPalette {
        width: 100%; height: 100%;
        navigate(r) => { root.route = r; root.cmdk = false; }
        close => { root.cmdk = false; }
    }
    if root.show-shell && root.me-open: MeMenu {
        width: 100%; height: 100%;
        navigate(r) => { root.route = r; root.me-open = false; }
        sign-out => { root.signed-in = false; root.me-open = false; }
        close => { root.me-open = false; }
    }
}
