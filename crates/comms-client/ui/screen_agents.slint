// Agents — the agent directory. Agents are first-class members: visible in the
// roster, on the record in the audit log, never a hidden listener. Screen 03.
import { Theme, AgentRow } from "theme.slint";
import { Avatar, SurfBadge, Chip, Hairline, Eyebrow, SevDot, ScreenHead, SelText } from "primitives.slint";

// one agent card — mono name, AGENT badge, trust statement, channels + sponsor
component AgentCard inherits Rectangle {
    in property <AgentRow> a;
    in property <string> purpose;
    background: Theme.paper-pure;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border-1;
    drop-shadow-color: #0e0f0c2e;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    VerticalLayout {
        padding: 20px;
        spacing: 16px;
        // head: avatar · name + AGENT + purpose · status dot
        HorizontalLayout {
            spacing: 14px;
            alignment: start;
            Avatar { initials: root.a.initials; agent: true; sz: 44px; }
            VerticalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    SelText {
                        text: root.a.name;
                        color: Theme.ink;
                        font-family: Theme.font-mono;
                        font-weight: 600;
                        font-size: 14px;
                    }
                    SurfBadge { text: "AGENT"; kind: "agent"; }
                }
                SelText {
                    text: root.purpose;
                    color: Theme.fg-2;
                    font-size: 13px;
                }
            }
            VerticalLayout {
                alignment: start;
                SevDot { level: root.a.status == "paused" ? "warn" : "pass"; }
            }
        }
        // trust statement
        Text {
            text: "read + post · cannot change membership";
            color: Theme.fg-3;
            font-size: 11px;
        }
        Hairline {}
        // channels · sponsor
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: "In";
                color: Theme.fg-3;
                font-size: 12px;
                vertical-alignment: center;
            }
            Chip { text: root.a.channels; }
            Rectangle { horizontal-stretch: 1; }
            SelText {
                text: "Sponsored by " + root.a.sponsor;
                color: Theme.fg-3;
                font-size: 12px;
            }
        }
        // recent-activity count
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            SelText {
                text: root.a.activity;
                color: Theme.citrate-green-dark;
                font-family: Theme.font-mono;
                font-size: 12px;
                font-weight: 600;
            }
            Text {
                text: "recorded actions · auditable";
                color: Theme.fg-3;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}

export component AgentsScreen inherits Rectangle {
    background: Theme.paper;

    property <[AgentRow]> agents: [
        { name: "@crm-agent", initials: "CA", status: "active", sponsor: "Priya", channels: "#deals", activity: 24 },
        { name: "@notetaker", initials: "NT", status: "active", sponsor: "Saul", channels: "#eng", activity: 61 },
    ];
    // purpose lines (parallel to agents — from data.jsx MEMBERS)
    property <[string]> purposes: [
        "Keeps deal records and conversation in sync.",
        "Summarizes threads and drafts follow-ups.",
    ];
    // recent activity for the first agent (@crm-agent)
    property <[{ ts: string, text: string }]> activity: [
        { ts: "09:31", text: "Drafted follow-up to Northwind and attached security one-pager." },
        { ts: "09:18", text: "Linked DEAL-2291 (Northwind) to #deals; set stage → Proposal." },
        { ts: "Jun 13", text: "Updated close date on DEAL-2284 to Aug 02 per Mateo." },
        { ts: "Jun 13", text: "Posted weekly pipeline summary." },
    ];

    VerticalLayout {
        ScreenHead {
            title: "Agents";
            subtitle: "AI participants join conversations like people — visible in the roster, on the record in the audit log. Never a hidden listener.";
        }
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            background: Theme.paper;
            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                // agent cards
                for a[i] in root.agents: AgentCard {
                    a: a;
                    purpose: root.purposes[i];
                    max-width: 1100px;
                }

                // recent activity for the first agent
                Rectangle {
                    max-width: 1100px;
                    background: Theme.paper-pure;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border-1;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text {
                                text: "@crm-agent";
                                color: Theme.ink;
                                font-family: Theme.font-mono;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Eyebrow { text: "RECENT ACTIVITY · AUDITABLE"; }
                        }
                        Hairline {}
                        for act[i] in root.activity: VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                Rectangle {
                                    width: 48px;
                                    SelText {
                                        text: act.ts;
                                        color: Theme.fg-3;
                                        font-family: Theme.font-mono;
                                        font-size: 11px;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                                SelText {
                                    text: act.text;
                                    color: Theme.ink-2;
                                    font-size: 13px;
                                    horizontal-stretch: 1;
                                }
                            }
                            if i < root.activity.length - 1: Hairline {}
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}
